# This file is only used to configure the monitor.
# Do not write any secret keys or sensitive information here.
#
# The monitor needs exactly one input: the experiment directory, entered in the
# web UI (or seeded below). Everything else — the task config, the examples
# directory, max_steps, the model name — is read from `args.json` inside that
# directory. There are deliberately no defaults for those: a stale default is
# what previously made a mis-pointed monitor render a blank page instead of an
# error.

# Optional: pre-fill the Experiment Path input. Leave empty to always type it.
MONITOR_EXPERIMENT_PATH=

# Fallback step ceiling, used only when args.json has no max_steps.
MAX_STEPS=100

# Flask server
FLASK_PORT=50011
FLASK_HOST=0.0.0.0
FLASK_DEBUG=false
